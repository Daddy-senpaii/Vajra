VAJRA_API_LISTEN_ADDR=:8080
VAJRA_API_ALLOWED_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
VAJRA_ADMIN_TOKEN=

# Required only for POST /v1/admin/cleanbrowsing/sync.
# Get the API key from the CleanBrowsing dashboard. Never put it in an app.
CLEANBROWSING_API_KEY=
CLEANBROWSING_API_URL=https://my.cleanbrowsing.org/api
CLEANBROWSING_PROFILE_NAME=default

# Public Adult Filter defaults. For a paid custom profile, replace both with
# the profile's resolver configuration from the CleanBrowsing dashboard.
CLEANBROWSING_DOT_HOST=adult-filter-dns.cleanbrowsing.org
CLEANBROWSING_DOH_URL=https://doh.cleanbrowsing.org/doh/adult-filter/
